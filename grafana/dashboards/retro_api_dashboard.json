{
  "annotations": {"list": []},
  "panels": [
    {
      "type": "graph",
      "title": "Requests per second",
      "targets": [
        {
          "expr": "sum by (endpoint)(rate(retro_api_requests_total[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "Request latency (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(retro_api_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} p95"
        }
      ],
      "id": 2
    }
    ,
    {
      "type": "graph",
      "title": "4xx/5xx error rate",
      "targets": [
        {
          "expr": "sum(rate(retro_api_requests_total{http_status=~\"4..\"}[1m])) by (endpoint)",
          "legendFormat": "4xx {{endpoint}}"
        },
        {
          "expr": "sum(rate(retro_api_requests_total{http_status=~\"5..\"}[1m])) by (endpoint)",
          "legendFormat": "5xx {{endpoint}}"
        }
      ],
      "id": 3
    }
  ],
  "title": "Retro API Overview"
}
