{
  "schemaVersion": 36,
  "title": "Security & Rate Limiting",
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Rate-limited requests/sec (429s)",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "expr": "sum(rate(rate_limit_requests_rejected_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate limit check latency - Redis round-trip (p95)",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}, "unit": "s"},
        "overrides": []
      },
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "expr": "histogram_quantile(0.95, sum(rate(rate_limit_check_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total requests vs rejected requests",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "expr": "sum(rate(retro_api_requests_total[1m]))",
          "legendFormat": "total req/s"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "expr": "sum(rate(rate_limit_requests_rejected_total[1m]))",
          "legendFormat": "rejected req/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top offending IPs (rejected requests)",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "expr": "topk(5, sum(rate(rate_limit_requests_rejected_total[5m])) by (client_ip))",
          "legendFormat": "{{client_ip}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "version": 1
}
